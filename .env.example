# Environment example — Swarm Debugger
# Copy to .env at repo root or backend/.env. Never commit real secrets.

APP_ENV=development
DATABASE_URL=sqlite:///./swarm_debugger.db
LLM_API_KEY=
LLM_MODEL=
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=swarm-debugger-sandbox:mvp
SANDBOX_STRICT=false
TRACE_ENABLED=true
FALSIFICATION_ENABLED=true
CAUSAL_ENABLED=true
MAX_SANDBOX_FAILURES=3
MAX_DEBUG_ROUNDS=5
CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
DEMO_EMAIL=demo@swarm.local
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
SESSION_COOKIE_NAME=swarm_session
SESSION_TTL_HOURS=12
